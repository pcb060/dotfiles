// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "indent_guides": {
    "active_line_width": 2,
    "line_width": 1,
  },
  "languages": {
    "YAML": {
      "indent_guides": {
        "background_coloring": "indent_aware",
        "coloring": "indent_aware",
      },
    },
    "Python": {
      "indent_guides": {
        "background_coloring": "indent_aware",
        "coloring": "indent_aware",
      },
    },
  },
  "mouse_wheel_zoom": true,
  "vim_mode": true,
  "show_whitespaces": "boundary",
  "terminal": {
    "font_family": "FantasqueSansM Nerd Font",
  },
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_free_models": false,
      "show_zen_models": false,
    },
  },
  "proxy": "",
  "when_closing_with_no_tabs": "keep_window_open",
  "agent_ui_font_size": 18.0,
  "agent_buffer_font_size": 16.0,
  "buffer_line_height": "standard",
  "cursor_shape": "block",
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "thinking",
        "mode": "plan",
        "model": "opencode-go/minimax-m3",
      },
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "buffer_font_family": "FantasqueSansM Nerd Font",
  "edit_predictions": {
    "open_ai_compatible_api": {
      "model": "opencode-go/qwen3.8-flash",
      "api_url": "https://opencode.ai/zen/go/v1/messages",
    },
    "provider": "open_ai_compatible_api",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Vitesse Dark",
  },
}
